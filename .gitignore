.build/
.swiftpm/
*.xcodeproj
.DS_Store
.shikki/

# per-package test scratch (CoreKitTestSupport.TestScratch) — run-namespaced, never committed
.tests/

# kagami — same rule as shikki: the auto-discover cache is regenerable, never committed; only scopes.override.toml is config
.kagami/scopes.toml
.kagami/scopes.yaml
.kagami/tmp/
.kagami/history.db*
# Secrets — env files and every backup of them never belong in git.
# A backup is git history, not a copy next to the file.
.env
.env.*
*.env
*.env.bak*
*.env.back*
!.env.example
!.env.template
!.env.sample
!.env.dist
!*.env.example
!*.env.template
